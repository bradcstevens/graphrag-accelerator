    <node id="FAMILY + CAREGIVER">
      <data key="d0">MEMBERSHIP TYPE</data>
      <data key="d1">A membership type at the zoo for families with an additional caregiver</data>
      <data key="d2">30c61f2e8eb9ec787335dd5146b1dcd3</data>
    </node>
    <node id="GRANDPARENT">
      <data key="d0">MEMBERSHIP TYPE</data>
      <data key="d1">A membership type at the zoo for grandparents</data>
      <data key="d2">30c61f2e8eb9ec787335dd5146b1dcd3</data>
    </node>
    <node id="PENGUIN CIRCLE">
      <data key="d0">MEMBERSHIP TYPE</data>
      <data key="d1">Penguin Circle is a premium membership level at the zoo designed for two named adults and children through age 18, along with the inclusion of two guests. This membership not only supports conservation efforts but also offers specific benefits such as complimentary member T-shirts.</data>
      <data key="d2">147e8049d7528fb16973a779f3b5c903,30c61f2e8eb9ec787335dd5146b1dcd3,9a382f591b41ffbb74f1a4a98b799b04</data>
    </node>
    <node id="PHONE NUMBER">
      <data key="d0">CONTACT INFORMATION</data>
      <data key="d1">Phone number provided for inquiries about booking events at the zoo</data>
      <data key="d2">30c61f2e8eb9ec787335dd5146b1dcd3</data>
    </node>
    <node id="EMAIL">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">30c61f2e8eb9ec787335dd5146b1dcd3</data>
    </node>
    <node id="FRIEND">
      <data key="d0">MEMBERSHIP OPTION</data>
      <data key="d1">Membership option that allows bringing a guest every time you visit the zoo</data>
      <data key="d2">147e8049d7528fb16973a779f3b5c903</data>
    </node>
    <node id="OTTER CIRCLE">
      <data key="d0">MEMBERSHIP LEVEL</data>
      <data key="d1">OTTER CIRCLE is a premium membership level at the zoo that supports conservation efforts and includes specific benefits. This membership allows a caregiver to bring member children without the cardholder being present.</data>
      <data key="d2">147e8049d7528fb16973a779f3b5c903,9a382f591b41ffbb74f1a4a98b799b04</data>
    </node>
    <node id="PARTNERS IN CONSERVATION">
      <data key="d0">MEMBERSHIP PROGRAM</data>
      <data key="d1">Partners in Conservation is a program that involves members of the zoo community who are dedicated to supporting the zoo's conservation efforts and operations. These members are committed to animal conservation and the future of the zoo, actively participating in initiatives that enhance the zoo's mission.</data>
      <data key="d2">147e8049d7528fb16973a779f3b5c903,db81d705b7a122acf504e0d62904dc66</data>
    </node>
    <node id="CURRENT MEMBERS">
      <data key="d0">MEMBERSHIP INFORMATION</data>
      <data key="d1">Section providing information about membership rates and benefits, subject to change without notice</data>
      <data key="d2">147e8049d7528fb16973a779f3b5c903</data>
    </node>
    <node id="PEAK ADMISSION">
      <data key="d0">ADMISSION PERIOD</data>
      <data key="d1">Admission period from April 1 to October 31 with specific opening hours</data>
      <data key="d2">147e8049d7528fb16973a779f3b5c903</data>
    </node>
    <node id="OFF-SEASON ADMISSION">
      <data key="d0">ADMISSION PERIOD</data>
      <data key="d1">Admission period from November 1 to March 31 with specific opening hours</data>
      <data key="d2">147e8049d7528fb16973a779f3b5c903</data>
    </node>
    <node id="VETERANS">
      <data key="d0">DISCOUNT PROGRAM</data>
      <data key="d1">Veterans, along with active-duty military personnel, can benefit from a program that offers reduced price admission tickets. This initiative aims to provide financial relief and acknowledge their service.</data>
      <data key="d2">147e8049d7528fb16973a779f3b5c903,3a13fc10eb422fca000ef83965be7c54</data>
    </node>
    <node id="MUSEUMS FOR ALL">
      <data key="d0">ACCESSIBILITY PROGRAM</data>
      <data key="d1">Program ensuring educational and recreational benefits of the zoo are accessible to all, regardless of income</data>
      <data key="d2">147e8049d7528fb16973a779f3b5c903</data>
    </node>
    <node id="CONSERVATION GLOBALLY">
      <data key="d0">CONSERVATION EFFORT</data>
      <data key="d1">Global conservation efforts supported by the Seneca Park Zoo Society through various initiatives</data>
      <data key="d2">147e8049d7528fb16973a779f3b5c903</data>
    </node>
    <node id="CONSERVATION LOCALLY">
      <data key="d0">CONSERVATION EFFORT</data>
      <data key="d1">Local conservation efforts by the Seneca Park Zoo to inspire the community to take action for wildlife</data>
      <data key="d2">147e8049d7528fb16973a779f3b5c903</data>
    </node>
    <node id="CONSERVATION AT THE ZOO">
      <data key="d0">CONSERVATION EFFORT</data>
      <data key="d1">Conservation efforts at the zoo level, involving animals and visitors contributing to conservation science</data>
      <data key="d2">147e8049d7528fb16973a779f3b5c903</data>
    </node>
    <node id="EVENT VIEWS NAVIGATION">
      <data key="d0">EVENT SECTION</data>
      <data key="d1">The "EVENT VIEWS NAVIGATION" is a section within the document designed to facilitate navigation for viewing different events. It provides users with the necessary tools to easily access and explore various event views.</data>
      <data key="d2">147e8049d7528fb16973a779f3b5c903,22b9ac11454bc5ebe5232264311d50c8,4ca56498269e96d3b657d78ec7d10ccc,5a67e66d1245cd5cad2cb1484b951ab5,5f6c454baab0626e35f40eeabb8bdf80,9fbeec723e4f071989819b22d7317dc6,e3c5b5a66202ce1617b0ce83eb744e23,e4a5ea254e91502ea1e808cd4bf5d6d8</data>
    </node>
    <node id="DEAF CULTURE AWARENESS DAY">
      <data key="d0">EVENT</data>
      <data key="d1">Deaf Culture Awareness Day is an event held at the zoo dedicated to celebrating and raising awareness about Deaf culture. This event involves partnerships with educational institutions, including the Rochester School for the Deaf, to provide accessible programming. The day is marked by various activities that highlight the significance of Deaf culture, aiming to educate and engage attendees in an inclusive environment.</data>
      <data key="d2">147e8049d7528fb16973a779f3b5c903,25244450e63663bca5ac126d6ed1c735,360b21cff28e96518b1080330f37b4f1,37145c80bbad9e7bb1716a1e0492645e,9b7c814666ecc42fbf1a45118e7f2977,9fbeec723e4f071989819b22d7317dc6,ede5b69e131b6efb49c20f681226707c</data>
    </node>
    <node id="ELEPHANT AWARENESS DAY">
      <data key="d0">EVENT</data>
      <data key="d1">Elephant Awareness Day is a special event dedicated to raising awareness about elephants, scheduled to take place on September 22, 2024, at Seneca Park Zoo. This day coincides with Deaf Culture Awareness Day and features various activities and educational sessions designed to celebrate and inform participants about elephants. Attendees are encouraged to wear grey attire to show their support and solidarity with the cause. The event aims to engage the community and enhance their understanding of elephants, highlighting the importance of their conservation.</data>
      <data key="d2">147e8049d7528fb16973a779f3b5c903,1e20e07194c6b756df1b77ab0d6b272b,25244450e63663bca5ac126d6ed1c735,360b21cff28e96518b1080330f37b4f1,37145c80bbad9e7bb1716a1e0492645e,79a2d4b637ef8098cbe540902636ddbf,937ae63cfd0860b674756ae48deb18d1,9b7c814666ecc42fbf1a45118e7f2977,ede5b69e131b6efb49c20f681226707c</data>
    </node>
    <node id="MARINE BIRDS OF THE AMERICAS">
      <data key="d0">EVENT</data>
      <data key="d1">The event titled "MARINE BIRDS OF THE AMERICAS" features a comprehensive discussion on marine birds and their conservation efforts in the Americas. It includes a conversation with Sea McKeon, who is joined by Randi Minetor for a detailed discussion on the subject. This event aims to engage attendees in understanding the importance of marine bird conservation across the Americas.</data>
      <data key="d2">147e8049d7528fb16973a779f3b5c903,1e20e07194c6b756df1b77ab0d6b272b,25244450e63663bca5ac126d6ed1c735,37145c80bbad9e7bb1716a1e0492645e,9fbeec723e4f071989819b22d7317dc6</data>
    </node>
    <node id="POLAR BEARS">
      <data key="d0">CONSERVATION FOCUS</data>
      <data key="d1">POLAR BEARS are a species of bear that are heavily dependent on sea ice and are currently subject to various conservation efforts. One such effort is led by Seneca Park Zoo, which focuses on polar bear conservation through partnerships with organizations like Polar Bears International. Additionally, there is a project aimed at increasing awareness and support for the habitat of polar bears. Research is also being conducted on the impact of land-based, human-provisioned foods on polar bears due to the loss of their sea ice habitats.</data>
      <data key="d2">147e8049d7528fb16973a779f3b5c903,14d429568463adbb525417ad6aa15254,9693c6d355708849ecd97fe93b0cd8f2,f7d18cffd13aa901313d3d4fceef2575</data>
    </node>
    <node id="ZOO MEMBERS">
      <data key="d0">MEMBERSHIP CATEGORY</data>
      <data key="d1">Zoo members are a category of zoo visitors who hold memberships and enjoy exclusive benefits. These individuals have the privilege of early access to the zoo starting at 9:30 a.m. from April 1 through October 31, among other advantages. The benefits of being a zoo member include early entry and other privileges that enhance their zoo experience.</data>
      <data key="d2">147e8049d7528fb16973a779f3b5c903,1cb71251823c004ebcfe91eef39fc913,25244450e63663bca5ac126d6ed1c735,6d14ad0fec20f957fa86ed5bba9c5842,71e73f97d564b8d56227d2c4f76c45bd,7e4abb755a8debc751dc717377114f5a,bb91ca31332be3d1e54ad385275e6284,f852d4fb9eeece13b559d38077322cb8</data>
    </node>
    <node id="DIGITAL MEMBERSHIP CARDS">
      <data key="d0">MEMBERSHIP BENEFIT</data>
      <data key="d1">Benefit included in the zoo membership that provides digital access to membership cards</data>
      <data key="d2">147e8049d7528fb16973a779f3b5c903</data>
    </node>
    <node id="ZOO TICKETS">
      <data key="d0">PRODUCT</data>
      <data key="d1">Tickets that can be purchased for admission to the zoo</data>
      <data key="d2">147e8049d7528fb16973a779f3b5c903</data>
    </node>
    <node id="ZOO MEMBERSHIP BENEFITS">
      <data key="d0">MEMBERSHIP BENEFIT</data>
      <data key="d1">Exclusive benefits available to zoo members, including discounts at other zoos and aquariums</data>
      <data key="d2">147e8049d7528fb16973a779f3b5c903</data>
    </node>
    <node id="MEMBER ENTRANCE">
      <data key="d0" />
      <data key="d1">The "MEMBER ENTRANCE" at the Zoo is a designated entry point exclusively for members to gain admission. Additionally, this location offers adult-sized merchandise available for purchase at a specific price.</data>
      <data key="d2">147e8049d7528fb16973a779f3b5c903,9a382f591b41ffbb74f1a4a98b799b04,db81d705b7a122acf504e0d62904dc66</data>
    </node>
    <node id="SNOW LEOPARDS">
      <data key="d0">SPECIES</data>
      <data key="d1">Snow leopards are cold-climate animals from Asia, known for their adaptations to cold environments. They were featured during the Cold Asia Awareness Weekend 2024, an event focused on raising awareness about cold-climate animals in Asia. Snow leopards are an endangered species facing threats such as habitat loss, hunting, and poaching.</data>
      <data key="d2">2c20259c06c872b8077b598161f55f87,360b21cff28e96518b1080330f37b4f1,79a2d4b637ef8098cbe540902636ddbf,9fbeec723e4f071989819b22d7317dc6,addd5bbe449c19cf2a6ed52ace1e9869</data>
    </node>
    <node id="RED PANDAS">
      <data key="d0">SPECIES</data>
      <data key="d1">Red pandas are cold-climate animals from Asia that were featured during the Cold Asia Awareness Weekend 2024. They are known for their adaptations to cold environments. Red pandas are an endangered species facing threats from habitat loss, climate change, deforestation, poaching, and the illegal pet trade.</data>
      <data key="d2">2c20259c06c872b8077b598161f55f87,360b21cff28e96518b1080330f37b4f1,79a2d4b637ef8098cbe540902636ddbf,9fbeec723e4f071989819b22d7317dc6,addd5bbe449c19cf2a6ed52ace1e9869</data>
    </node>
    <node id="SNOW LEOPARD TRUST (SLT)">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Organization partnered with Seneca Park Zoo to protect snow leopards through community-based conservation projects</data>
      <data key="d2">2c20259c06c872b8077b598161f55f87</data>
    </node>
    <node id="RED PANDA NETWORK (RPN)">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Organization committed to the conservation of red pandas and their habitat through education and empowerment of local communities</data>
      <data key="d2">2c20259c06c872b8077b598161f55f87</data>
    </node>
    <node id="COMMUNITY BEEKEEPING PROGRAMMING">
      <data key="d0">PROGRAM</data>
      <data key="d1">Program that delivers honeybee hives to communities in snow leopard habitats to create alternative income sources and reduce conflicts</data>
      <data key="d2">2c20259c06c872b8077b598161f55f87</data>
    </node>
    <node id="PANCHTHAR-ILAM-TAPLEJUNG (PIT) NATIONAL FOREST">
      <data key="d0">LOCATION</data>
      <data key="d1">Protected area dedicated to red pandas, supported by Seneca Park Zoo and Red Panda Network</data>
      <data key="d2">2c20259c06c872b8077b598161f55f87</data>
    </node>
    <node id="INTERNATIONAL RHINO FOUNDATION (IRF)">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The International Rhino Foundation (IRF) is an organization committed to ensuring the survival of the world&#8217;s rhino species through conservation and research. In addition to its primary focus on rhinos, IRF collaborates with partners such as the Seneca Park Zoo to support broader wildlife conservation efforts.</data>
      <data key="d2">2c20259c06c872b8077b598161f55f87,56955a6240521bdd59e742c5f6dbeb24</data>
    </node>
    <node id="AFRICAN PARKS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">AFRICAN PARKS is an organization that collaborates with Seneca Park Zoo to address elephant conservation. Additionally, AFRICAN PARKS operates Garamba National Park, further emphasizing its commitment to wildlife conservation efforts.</data>
      <data key="d2">2c20259c06c872b8077b598161f55f87,56955a6240521bdd59e742c5f6dbeb24</data>
    </node>
    <node id="GIRAFFE CONSERVATION FOUNDATION (GCF)">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Giraffe Conservation Foundation (GCF) is an international conservation organization that employs innovative approaches to preserve giraffes in their natural habitats. Additionally, GCF collaborates with Seneca Park Zoo to further support the conservation efforts for giraffes.</data>
      <data key="d2">2c20259c06c872b8077b598161f55f87,56955a6240521bdd59e742c5f6dbeb24</data>
    </node>
    <node id="GARAMBA NATIONAL PARK">
      <data key="d0">LOCATION</data>
      <data key="d1">Garamba National Park, located in the Democratic Republic of Congo, is recognized as a World Heritage Site. It is operated by African Parks and receives support from Seneca Park Zoo specifically for elephant conservation efforts.</data>
      <data key="d2">2c20259c06c872b8077b598161f55f87,56955a6240521bdd59e742c5f6dbeb24</data>
    </node>
    <node id="INTERNATIONAL ELEPHANT FOUNDATION (IEF)">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">A non-profit corporation dedicated to the conservation of African and Asian elephants worldwide</data>
      <data key="d2">56955a6240521bdd59e742c5f6dbeb24</data>
    </node>
    <node id="LION LANDSCAPES">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">LION LANDSCAPES is an organization that collaborates with Seneca Park Zoo to fund community-based conservation programs. It operates in Africa with the mission to ensure that ecosystems support not only the local communities but also lions and their prey for future generations.</data>
      <data key="d2">012abaca5ac0051ac1d5f45b5ef82a3d,56955a6240521bdd59e742c5f6dbeb24</data>
    </node>
    <node id="MADAGASCAR">
      <data key="d0">LOCATION</data>
      <data key="d1">Madagascar is an island nation located off the southeast coast of mainland Africa. It is renowned for its unique wildlife, including the native Madagascar hissing cockroaches and Madagascar tree boas. The nation is also actively involved in conservation efforts, particularly through partnerships supported by entities like the Seneca Park Zoo, which focuses on lemur conservation. Additionally, Madagascar is engaged in comprehensive environmental initiatives aimed at building healthy forests and communities, which involve more than just tree planting. These efforts are crucial for maintaining the ecological balance and supporting the diverse species found on the island.</data>
      <data key="d2">0fc43ac1990ac497fc8887d975c38133,4f0216fbf293d41283768fcf5c6a176f,56955a6240521bdd59e742c5f6dbeb24</data>
    </node>
    <node id="WISE TROPICS INC">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">One of the Malagasy organizations that Seneca Park Zoo partners with for lemur conservation</data>
      <data key="d2">56955a6240521bdd59e742c5f6dbeb24</data>
    </node>
    <node id="MADAGASCAR FAUNA GROUP">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Madagascar Fauna Group is an organization that benefits from the proceeds of the Party Madagascar event. It is one of the Malagasy organizations that collaborates with Seneca Park Zoo specifically for lemur conservation efforts.</data>
      <data key="d2">56955a6240521bdd59e742c5f6dbeb24,71e73f97d564b8d56227d2c4f76c45bd</data>
    </node>
    <node id="DUKE LEMUR CENTER">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Duke Lemur Center is an organization that benefits from the proceeds of the Party Madagascar event. It is also one of the Malagasy organizations that partners with Seneca Park Zoo for lemur conservation.</data>
      <data key="d2">56955a6240521bdd59e742c5f6dbeb24,71e73f97d564b8d56227d2c4f76c45bd</data>
    </node>
    <node id="LEMUR CONSERVATION FOUNDATION">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Lemur Conservation Foundation is an organization that benefits from the proceeds of the Party Madagascar event. It is also one of the Malagasy organizations that partners with Seneca Park Zoo for lemur conservation efforts.</data>
      <data key="d2">56955a6240521bdd59e742c5f6dbeb24,71e73f97d564b8d56227d2c4f76c45bd</data>
    </node>
    <node id="DR. PATRICIA WRIGHT">
      <data key="d0">PERSON</data>
      <data key="d1">Dr. Patricia Wright is a prominent figure in the field of conservation, particularly focusing on Madagascar. She is a key partner in the Madagascar conservation project and leads the Institute for the Conservation of Tropical Environments. Additionally, Dr. Wright is associated with WISE Tropics Inc, where she collaborates with Seneca Park Zoo on lemur conservation efforts. Her expertise and leadership play a crucial role in the preservation of tropical environments and species.</data>
      <data key="d2">2690f9504dfb56154145abcec34c3c4f,56955a6240521bdd59e742c5f6dbeb24,9693c6d355708849ecd97fe93b0cd8f2</data>
    </node>
    <node id="PARTY MADAGASCAR">
      <data key="d0" />
      <data key="d1">Party Madagascar is an event where the proceeds from ticket sales are dedicated to supporting various conservation organizations.</data>
      <data key="d2">56955a6240521bdd59e742c5f6dbeb24,71e73f97d564b8d56227d2c4f76c45bd</data>
    </node>
    <node id="TREE NURSERY">
      <data key="d0">PROJECT</data>
      <data key="d1">A project funded by Seneca Park Zoo to plant 10,000 trees in Kiranomena, a remote village</data>
      <data key="d2">71e73f97d564b8d56227d2c4f76c45bd</data>
    </node>
    <node id="KIRANOMENA">
      <data key="d0">LOCATION</data>
      <data key="d1">A remote village where the tree nursery project is located</data>
      <data key="d2">71e73f97d564b8d56227d2c4f76c45bd</data>
    </node>
    <node id="DR. PATRICIA WRIGHT&#8217;S WISE TROPICS INC">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">An organization supported by proceeds from Party Madagascar event</data>
      <data key="d2">71e73f97d564b8d56227d2c4f76c45bd</data>
    </node>
    <node id="TROPICS COMPLEX">
      <data key="d0">PROJECT</data>
      <data key="d1">The Tropics Complex is a new project at Seneca Park Zoo, which is part of the Seneca Park Zoo Master Plan. This initiative aims to bring Bornean orangutans back to the zoo, enhancing both the zoo's offerings and its conservation efforts.</data>
      <data key="d2">5a67e66d1245cd5cad2cb1484b951ab5,71e73f97d564b8d56227d2c4f76c45bd</data>
    </node>
    <node id="SOUTHERN AFRICAN FOUNDATION FOR THE CONSERVATION OF COASTAL BIRDS (SANCCOB)">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">A nonprofit dedicated to reversing the decline of seabird populations in South Africa</data>
      <data key="d2">71e73f97d564b8d56227d2c4f76c45bd</data>
    </node>
    <node id="AFRICAN PENGUINS">
      <data key="d0">SPECIES</data>
      <data key="d1">A species of penguins threatened by various environmental and human factors</data>
      <data key="d2">71e73f97d564b8d56227d2c4f76c45bd</data>
    </node>
    <node id="ASSOCIATION OF ZOOS AND AQUARIUMS AFRICAN PENGUIN SAFE PROGRAM">
      <data key="d0">PROGRAM</data>
      <data key="d1">A conservation program focusing on the conservation, public education, and breeding of African penguins</data>
      <data key="d2">71e73f97d564b8d56227d2c4f76c45bd</data>
    </node>
    <node id="SPECIES SURVIVAL PLAN">
      <data key="d0">PROGRAM</data>
      <data key="d1">The Species Survival Plan is a breeding and management program that involves various facilities, including Seneca Park Zoo, to ensure the survival of endangered species such as African penguins, white rhinos, and African lions. The program strategically manages the placement of these animals across different facilities, taking into consideration factors like age, sex, genetics, and exhibit availability to optimize breeding outcomes and maintain genetic diversity.</data>
      <data key="d2">02ed48373f13fe54d7540874b5d52187,71e73f97d564b8d56227d2c4f76c45bd</data>
    </node>
    <node id="GLOBAL CONSERVATION">
      <data key="d0">CONCEPT</data>
      <data key="d1">Efforts supported by Seneca Park Zoo to conserve wildlife and wild places globally</data>
      <data key="d2">71e73f97d564b8d56227d2c4f76c45bd</data>
    </node>
    <node id="SENECA PARK ZOO SOCIETY">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Seneca Park Zoo Society is an organization intricately linked with Seneca Park Zoo, primarily engaged in supporting charitable fundraisers and managing donation requests. It offers various positions and internships at the zoo, enhancing its operational and educational capacities. Additionally, the society is known for hosting annual meetings and various events at the zoo, fostering community engagement and awareness. Beyond its local impact, the Seneca Park Zoo Society extends its influence globally by making grants to conservation organizations, thereby contributing to wildlife preservation and environmental sustainability.</data>
      <data key="d2">71e73f97d564b8d56227d2c4f76c45bd,807d66922b9b185cfc13dde4cefa5199,b0b9a7e2f9c8c13b352787d0d7c78fe6,f852d4fb9eeece13b559d38077322cb8</data>
    </node>
    <node id="MONTEREY BAY AQUARIUM&#8217;S SEAFOOD WATCH">
      <data key="d0">PROGRAM</data>
      <data key="d1">A program that provides a guide for sustainable seafood purchases</data>
      <data key="d2">71e73f97d564b8d56227d2c4f76c45bd</data>
    </node>
    <node id="GENESEE RIVER">
      <data key="d0">LOCATION</data>
      <data key="d1">The Genesee River, adjacent to Seneca Park Zoo, has been a focal point for environmental restoration and biodiversity studies. This river is undergoing lake sturgeon restoration and has also been equipped with SeaBins to collect water debris, highlighting its significance in conservation efforts.</data>
      <data key="d2">258b72191485f555888b5c9fa62c58e7,2690f9504dfb56154145abcec34c3c4f,37c417e9fb3db505eeeaa12d3f028e77,45d8d5e706be27731202735287418cab</data>
    </node>
    <node id="USGS TUNISON AQUATIC SCIENCE CENTER">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Organization involved in the lake sturgeon restoration project alongside Seneca Park Zoo</data>
      <data key="d2">45d8d5e706be27731202735287418cab</data>
    </node>
    <node id="DR. JEFF WYATT">
      <data key="d0">PERSON</data>
      <data key="d1">Former Director of Animal Health &amp; Conservation at Seneca Park Zoo, introduced to Dr. Dawn Dittman to start the sturgeon restoration project</data>
      <data key="d2">45d8d5e706be27731202735287418cab</data>
    </node>
    <node id="DR. DAWN DITTMAN">
      <data key="d0">PERSON</data>
      <data key="d1">USGS Aquatic Ecologist who began the lake sturgeon restoration project in the Genesee River</data>
      <data key="d2">45d8d5e706be27731202735287418cab</data>
    </node>
    <node id="E.C.O. CENTER">
      <data key="d0">FACILITY</data>
      <data key="d1">The E.C.O. Center at Seneca Park Zoo serves as a habitat for a variety of species, including the Giant Day Gecko and juvenile sturgeon. It is specifically noted as the home to a male Giant Day Gecko. This facility plays a crucial role in the exhibition and conservation of these species within the zoo's ecosystem.</data>
      <data key="d2">276b3724b32d115ba04f28d3aead11c1,45d8d5e706be27731202735287418cab,5b32cc9af4441f9451a68576d6befb8c</data>
    </node>
    <node id="URBAN ECOLOGISTS">
      <data key="d0">PROFESSION</data>
      <data key="d1">Urban Ecologists are a dynamic team consisting of young individuals and professionals at Seneca Park Zoo. They are actively involved in stewardship projects and various activities aimed at enhancing the natural environment and fostering community engagement. Additionally, they participate in the sturgeon restoration program, further demonstrating their commitment to environmental conservation and community involvement.</data>
      <data key="d2">45d8d5e706be27731202735287418cab,fe425a1c2a00d13b75ddffe65e03463e</data>
    </node>
    <node id="STEVE LACY">
      <data key="d0">PERSON</data>
      <data key="d1">Steve Lacy has been appointed as the Superintendent of Seneca Park Zoo. In his role as Director of the zoo, he has commented on the conservation efforts and expressed future hopes for the lake sturgeon.</data>
      <data key="d2">45d8d5e706be27731202735287418cab,e9b8eaf510aa9cc4cf1ab929ac8c9706</data>
    </node>
    <node id="NYSDEC">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">New York State Department of Environmental Conservation, collaborates in the sturgeon restoration and other environmental programs</data>
      <data key="d2">45d8d5e706be27731202735287418cab</data>
    </node>
    <node id="USFWS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">United States Fish &amp; Wildlife Service, a partner in conservation efforts with Seneca Park Zoo</data>
      <data key="d2">45d8d5e706be27731202735287418cab</data>
    </node>
    <node id="UNITED STATES GEOLOGICAL SURVEY">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The United States Geological Survey (USGS) is a US government agency dedicated to conducting geological surveys and research. It is also involved in various collaborative projects, including the lake sturgeon restoration project alongside Seneca Park Zoo.</data>
      <data key="d2">45d8d5e706be27731202735287418cab,f7d18cffd13aa901313d3d4fceef2575</data>
    </node>
