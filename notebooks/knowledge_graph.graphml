    <node id="CITIZEN SCIENCE">
      <data key="d0">CONCEPT</data>
      <data key="d1">A method of scientific research conducted, in whole or in part, by amateur or nonprofessional scientists, often involving public participation and collaboration.</data>
      <data key="d2">258b72191485f555888b5c9fa62c58e7</data>
    </node>
    <node id="BIOSURVEYS AND CITIZEN SCIENCE PROGRAMS">
      <data key="d0">PROGRAM</data>
      <data key="d1">Programs at Seneca Park Zoo where participants learn to observe and document local flora and fauna and contribute to citizen science platforms.</data>
      <data key="d2">258b72191485f555888b5c9fa62c58e7</data>
    </node>
    <node id="IMAPINVASIVES">
      <data key="d0">TOOL</data>
      <data key="d1">A tool used for the early detection and management of invasive species, utilized by staff and participants at Seneca Park Zoo.</data>
      <data key="d2">258b72191485f555888b5c9fa62c58e7</data>
    </node>
    <node id="ONE CUBIC FOOT">
      <data key="d0">PROJECT</data>
      <data key="d1">A project led by photographer David Liittschwager documenting biodiversity in a cubic foot of various ecosystems, replicated by Seneca Park Zoo in the Genesee River.</data>
      <data key="d2">258b72191485f555888b5c9fa62c58e7</data>
    </node>
    <node id="DAVID LIITTSCHWAGER">
      <data key="d0">INDIVIDUAL</data>
      <data key="d1">David Liittschwager is a photographer and environmentalist who created and leads the One Cubic Foot project. He has been actively involved in documenting biodiversity globally, with a specific focus on Madagascar where he heads the project team. Through the One Cubic Foot project, Liittschwager captures the diverse range of life found in a single cubic foot of space in various ecosystems, highlighting the intricate and often overlooked biodiversity of our planet.</data>
      <data key="d2">258b72191485f555888b5c9fa62c58e7,2690f9504dfb56154145abcec34c3c4f,5c44b860bfe5a13d4dd428f89dc36b08</data>
    </node>
    <node id="FROGWATCH USA">
      <data key="d0">PROGRAM</data>
      <data key="d1">FrogWatch USA is a citizen science program initiated by the Association of Zoos and Aquariums and hosted at Seneca Park Zoo. The program focuses on monitoring and studying frogs and toads within local wetlands. Additionally, FrogWatch USA includes volunteer training sessions at Seneca Park Zoo to educate participants on the importance of amphibian conservation and the methodologies used in monitoring these species.</data>
      <data key="d2">258b72191485f555888b5c9fa62c58e7,2690f9504dfb56154145abcec34c3c4f,807d66922b9b185cfc13dde4cefa5199</data>
    </node>
    <node id="INATURALIST">
      <data key="d0">PLATFORM</data>
      <data key="d1">A citizen science platform used by Seneca Park Zoo for outdoor programs and data collection on local wildlife.</data>
      <data key="d2">258b72191485f555888b5c9fa62c58e7</data>
    </node>
    <node id="URBAN WILDLIFE INFORMATION NETWORK (UWIN)">
      <data key="d0">NETWORK</data>
      <data key="d1">A network of researchers studying urban wildlife behavior across multiple cities, with Seneca Park Zoo leading efforts in Rochester.</data>
      <data key="d2">258b72191485f555888b5c9fa62c58e7</data>
    </node>
    <node id="CITY NATURE CHALLENGE">
      <data key="d0">EVENT</data>
      <data key="d1">A yearly biosurvey contest on iNaturalist involving nearly 200 cities, focusing on urban biodiversity.</data>
      <data key="d2">258b72191485f555888b5c9fa62c58e7</data>
    </node>
    <node id="GLOBE">
