      <data key="d2">3151bb5c0b7a18f5142a741f163a92cd</data>
    </node>
    <node id="CAF&#201; MENU">
      <data key="d0">MENU, ITEM LIST</data>
      <data key="d1">Displayed on dual digital screens at the Trailside Caf&#233;, listing various food and drink options with prices</data>
      <data key="d2">3151bb5c0b7a18f5142a741f163a92cd</data>
    </node>
    <node id="BEVERAGES">
      <data key="d0">PRODUCT, ITEM LIST</data>
      <data key="d1">Includes water, energy drinks, and juices, neatly arranged behind a protective glass counter in the caf&#233;</data>
      <data key="d2">3151bb5c0b7a18f5142a741f163a92cd</data>
    </node>
    <node id="CAF&#201; INTERIOR">
      <data key="d0">DESIGN, LOCATION FEATURE</data>
      <data key="d1">Features contemporary design elements like wood flooring and metallic finishes, contributing to a cozy yet modern ambiance</data>
      <data key="d2">3151bb5c0b7a18f5142a741f163a92cd</data>
    </node>
    <node id="GENESEE TRAIL">
      <data key="d0">LOCATION, TOURIST ATTRACTION</data>
      <data key="d1">The Genesee Trail is a picturesque path marked by a rustic wooden archway and playful signage, enveloped by lush green foliage, creating a serene atmosphere. It is situated within a zoo, where the musical piece '10,000 Birds' is performed, adding a unique auditory experience to the visual tranquility of the trail.</data>
      <data key="d2">3151bb5c0b7a18f5142a741f163a92cd,e3c5b5a66202ce1617b0ce83eb744e23</data>
    </node>
    <node id="DIPPIN' DOTS STAND">
      <data key="d0">BUSINESS, LOCATION</data>
      <data key="d1">The Dippin' Dots Stand is a vibrant and inviting vendor that sells Dippin' Dots ice cream. It is decorated in bright blues and displays a variety of flavors on its menu. The stand contributes to a serene and anticipatory atmosphere as it waits for customers.</data>
      <data key="d2">191f7e3587b17342ccf913b6c3d77933,3151bb5c0b7a18f5142a741f163a92cd</data>
    </node>
