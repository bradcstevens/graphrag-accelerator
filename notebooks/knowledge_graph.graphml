      <data key="d2">f4312fae324599a53376de32cd0ef6f6</data>
    </node>
    <node id="STAY UPDATED">
      <data key="d0">SECTION</data>
      <data key="d1">"STAY UPDATED" is a section designed to encourage visitors and attendees at the zoo to sign up and stay informed about the ongoing transformation of the zoo, its various campaigns, and other events or happenings. This feature aims to keep individuals connected and updated with the latest developments and activities at the zoo.</data>
      <data key="d2">f4312fae324599a53376de32cd0ef6f6,f852d4fb9eeece13b559d38077322cb8</data>
    </node>
    <node id="ROCKY COAST TOUR">
      <data key="d0">TOUR</data>
      <data key="d1">The "ROCKY COAST TOUR" is an event at Seneca Park Zoo where guests have the opportunity to interact with sea lions and learn about their care and enrichment. This tour is highlighted as one of the experiences available at the zoo, allowing visitors to engage closely with these marine animals and gain insights into their daily management and welfare.</data>
      <data key="d2">25244450e63663bca5ac126d6ed1c735,2aff8b93e799e360f021a8d30f349244,6f62d2860d0f3958caa46b6051845518,f4312fae324599a53376de32cd0ef6f6</data>
    </node>
    <node id="TRAILSIDE CAFE">
      <data key="d0" />
      <data key="d1">Trailside Cafe is a seasonal cafe located at the zoo, providing a unique dining experience for visitors. It offers themed food items, such as Elephant Earfried dough, allowing guests to conclude their zoo visit with a memorable meal.</data>
      <data key="d2">25244450e63663bca5ac126d6ed1c735,bb91ca31332be3d1e54ad385275e6284,f4312fae324599a53376de32cd0ef6f6</data>
    </node>
    <node id="ELEPHANT ENCOUNTER">
      <data key="d0">EVENT, EXPERIENCE</data>
      <data key="d1">Elephant Encounter is an event hosted at Seneca Park Zoo where guests have the opportunity to meet African Elephants. This experience includes a tour of the barn and provides insights into the elephants' personalities and care. Visitors can learn more about these magnificent creatures in an engaging and educational setting.</data>
      <data key="d2">25244450e63663bca5ac126d6ed1c735,2aff8b93e799e360f021a8d30f349244,6f62d2860d0f3958caa46b6051845518</data>
    </node>
    <node id="GIRAFFE FEEDINGS">
      <data key="d0">EVENT, EXPERIENCE</data>
      <data key="d1">Giraffe Feedings is an event held at Seneca Park Zoo where guests have the opportunity to feed and meet Masai giraffes. This experience allows visitors to interact closely with these majestic animals, enhancing their visit to the zoo.</data>
      <data key="d2">2aff8b93e799e360f021a8d30f349244,6f62d2860d0f3958caa46b6051845518,93b8cec1c161812c432a361ca9f5e110</data>
    </node>
    <node id="RHINO ENCOUNTER">
      <data key="d0">EVENT, EXPERIENCE</data>
      <data key="d1">The "Rhino Encounter" is an event held at Seneca Park Zoo where guests have the unique opportunity to meet and learn about Jiwe, a white rhino. During this experience, attendees can touch the rhino and gain insights from the animal care team about rhino conservation and care. This educational encounter provides a hands-on learning experience about rhinos, emphasizing the importance of wildlife conservation.</data>
      <data key="d2">25244450e63663bca5ac126d6ed1c735,2aff8b93e799e360f021a8d30f349244,6f62d2860d0f3958caa46b6051845518</data>
    </node>
    <node id="SAVANNA TOUR">
      <data key="d0">EVENT, EXPERIENCE</data>
      <data key="d1">A tour at Seneca Park Zoo that includes close encounters with animals of the African Savanna</data>
      <data key="d2">6f62d2860d0f3958caa46b6051845518</data>
    </node>
    <node id="ZOO EXPERIENCES">
      <data key="d0">CATEGORY</data>
      <data key="d1">A category of experiences offered at Seneca Park Zoo that allows guests to get close to various species</data>
      <data key="d2">6f62d2860d0f3958caa46b6051845518</data>
    </node>
    <node id="AMAZON RIVER EXPEDITION">
      <data key="d0">TRAVEL PROGRAM, EVENT</data>
      <data key="d1">A travel program by Seneca Park Zoo exploring the Amazon River Basin with various activities and stays"</data>
      <data key="d2">6f62d2860d0f3958caa46b6051845518</data>
    </node>
